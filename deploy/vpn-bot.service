[Unit]
Description=VPN Telegram Bot
After=network-online.target warp-routes.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vpn-service
EnvironmentFile=/opt/vpn-service/.env
Environment=BOT_LOCK_PATH=/run/vpn-bot/vpn-bot.lock
# This bot runs as root but shares vpn.db (journal_mode=WAL) with the vpn-bot-owned
# readers vpnbot-hy2-auth.service and vpn-bot-subscription.service. Re-assert the
# DB ownership BEFORE ExecStart reopens the DB and recreates the -wal/-shm
# sidecars: a root-owned vpn.db makes SQLite create them as root:root and both
# readers then die with "unable to open database file". Idempotent and silent when
# nothing needed fixing. Do not remove — deploy.sh installs the helper and asserts
# the resulting ownership post-deploy.
ExecStartPre=/usr/local/sbin/vpn-bot-db-perms
ExecStart=/opt/vpn-service/.venv/bin/python /opt/vpn-service/main.py
Restart=on-failure
RestartSec=5
User=root
Group=root
UMask=0077
# File-descriptor ceiling. With no LimitNOFILE the unit inherits systemd's default
# soft limit of 1024 (measured on the host 2026-08-11: PID of main.py at 1024 soft
# / 524288 hard) while the backends next to it set theirs explicitly. A literal is
# used rather than infinity on purpose — the hard limit here is 524288 and this
# process does not work with hundreds of thousands of descriptors.
LimitNOFILE=65536
PrivateTmp=true
ProtectHome=true
ProtectSystem=false
RuntimeDirectory=vpn-bot
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
