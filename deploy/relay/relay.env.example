# /opt/vpn-service/.env on an L4 RELAY host (NODE_ROLE=relay) — docs/relay.md.
#
# This is the WHOLE .env of a relay. The relay runs no bot, no database, no Xray,
# AmneziaWG or WARP, and has no Telegram token: config/settings.py is never
# loaded here. Only scripts/deploy.sh and scripts/vpn-relay-apply read this file.
#
# Install:  install -m 0600 -o root -g root deploy/relay/relay.env.example /opt/vpn-service/.env
# then edit RELAY_UPSTREAM_IPV4 below.
#
# Syntax: KEY=value; optional `export`, spaces around `=`, quotes and trailing
# `# comments` are accepted; the LAST assignment of a key wins; an empty value
# counts as unset.

# Host role. Without it the host is a main server (the default) and the deploy
# refuses to run when it finds vpn-relay.service active and no vpn-bot.service.
NODE_ROLE=relay

# IPv4 of the main server — every forwarded port goes to the same port here.
RELAY_UPSTREAM_IPV4=203.0.113.10

# Ports forwarded 1:1 (comma-separated, 1..65535). Default 443 each:
# TCP/443 = VLESS (REALITY / XHTTP), UDP/443 = Hysteria2.
RELAY_FORWARD_TCP_PORTS=443
RELAY_FORWARD_UDP_PORTS=443

# Optional: the WAN interface for the DNAT/masquerade rules. Default: the
# interface of the IPv4 default route (the deploy refuses if there is none or
# more than one).
# RELAY_WAN_IFACE=eth0

# Optional: SNI for the TLS-handshake step of `vpn-relay-apply check` (run by every
# deploy). Use the main server's XRAY_SNI; the certificate is verified. Unset =
# the handshake step is skipped (the TCP connect is still checked).
# RELAY_CHECK_SNI=www.example.com

# conntrack: every relayed flow is one entry in the kernel's conntrack table. Once
# it is full the kernel drops NEW flows; `vpn-relay-apply check` (every deploy) warns
# above 80% (nf_conntrack_count). Set at every start of vpn-relay.service, after
# the table (systemd-sysctl runs before nf_conntrack is loaded and cannot).
# net.netfilter.nf_conntrack_max — integer 8192..1048576, default 65536.
RELAY_CONNTRACK_MAX=65536
# net.netfilter.nf_conntrack_tcp_timeout_established, seconds — 300..432000, default
# 86400 (the kernel default is 432000 = 5 days).
RELAY_CONNTRACK_TCP_ESTABLISHED_TIMEOUT=86400

# INPUT filter — nftables table inet vpnrelay_input, applied together with the
# forwarding table (docs/relay.md#the-input-filter). Policy drop for everything that
# comes in to the relay ITSELF; let in: loopback, established/related, ICMP, ICMPv6,
# the DHCPv6 client, the SSH ports (found from the listening sockets of sshd /
# ssh.socket, never configured here) and the ports below. The relayed 443 is not
# affected (DNAT'ed flows never reach the input hook). on | off, default on.
# The first enable and every change of the TCP set arm a 5-minute dead-man:
# confirm with `vpn-relay-apply input-confirm` from a NEW ssh session.
RELAY_INPUT_FILTER=on
# Extra ports the filter lets in (comma-separated, 1..65535). Default: none.
RELAY_INPUT_EXTRA_TCP=
RELAY_INPUT_EXTRA_UDP=
# Ports that listen on a public address but are meant to stay closed from outside:
# `vpn-relay-apply check` (every deploy) does not call them "listening but filtered".
# RELAY_INPUT_CLOSED_TCP=
# RELAY_INPUT_CLOSED_UDP=
