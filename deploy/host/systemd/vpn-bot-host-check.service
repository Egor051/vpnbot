[Unit]
Description=vpn-bot host invariants: is the effective host state what the repo says (read-only)
Documentation=file:///opt/vpn-service/docs/host-state.md
# The SSH port migration looks for its proof first (docs/host-state.md#the-ssh-port):
# the boot run and the daily run of this timer are two of the moments phase 2 of a
# proven migration happens; then this check judges the result.
Wants=vpn-bot-ssh-port.service
After=vpn-bot-ssh-port.service
# Main: a UFW policy change still waiting for its proof is kept or reverted first
# (docs/host-state.md#the-firewall-ufw) — after a reboot this is the moment it happens.
# A relay has no such unit: Wants= of a missing unit is a no-op.
Wants=vpn-bot-ufw-deadman.service
After=vpn-bot-ufw-deadman.service

[Service]
Type=oneshot
# Read-only check; writes only /var/lib/vpn-bot-host-check/last.json (atomically).
# Exit 1 = BEATEN or MISMATCH found: the unit shows as failed and the journal has the
# rows. On the main server the bot reads last.json and alerts the superadmins.
ExecStart=/usr/local/sbin/vpn-bot-host-check
StateDirectory=vpn-bot-host-check
StateDirectoryMode=0755
UMask=0022
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
