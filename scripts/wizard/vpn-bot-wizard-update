#!/usr/bin/python3 -I
"""vpn-bot-wizard-update — the «Обновить бота» mode of the setup wizard (docs/wizard.md).

A thin, honest wrapper around the ONE supported redeploy path, scripts/redeploy.sh
(which runs deploy.sh from origin/main under systemd-run with its own lock, gates
and rollback). This helper adds nothing to the deploy itself; it runs it the way an
operator would and reads its verdict.

  plan      git fetch origin main; what would change: the commits HEAD..origin/main,
            CURRENT_SCHEMA_VERSION of HEAD and of origin/main and the live
            schema_version; then `CHECK=1 redeploy.sh` (deploy.sh PHASE1_ONLY=1: the
            whole read-only Phase 1, tests included). HEAD already at origin/main
            and force=0: a no-op plan, the CHECK is skipped.
  apply     only the revision the plan showed: `git fetch origin main` again, and when
            origin/main moved since the plan (other commits, maybe another migration
            than the superadmin confirmed) nothing is deployed — the run fails with
            "start the update again". Then `redeploy.sh` (FORCE=1 with force=1).
            deploy.sh stops and restarts the bot; this process runs in the wizard's
            own transient unit, so it lives on and the restarted bot picks the run up
            from the status file. (redeploy.sh fetches once more itself; a push in the
            seconds between the two fetches is reported by verify, never hidden.)
  verify    the deploy output has "===== DEPLOY OK =====" (or deploy.sh's "nothing
            to deploy") and vpn-bot.service is active.
  rollback  deploy.sh rolls itself back (code, venv, DB, configs, unit) and prints
            "===== ROLLBACK REPORT ====="; this step reports it and checks that the
            bot runs. No report = deploy.sh stopped before Phase 2 (nothing changed)
            or never finished: failed, read the log.

redeploy.sh is called with REDEPLOY_ATTACH=pipe: `systemd-run --wait --pipe` instead of
`--pty` (there is no terminal here) and `set -o pipefail`, so its exit code is
deploy.sh's. The verdict is still read from the report text, exactly as an operator
reads it: the text is what deploy.sh guarantees.

Parameter: force — 1 redeploys even when HEAD already equals origin/main (FORCE=1).
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import contextlib
import json
import os
import re
import select
import sqlite3
import subprocess  # noqa: S404 — argv lists of fixed programs, never a shell
import sys
import time
from pathlib import Path
from types import ModuleType
from typing import Any


def _load_lib() -> ModuleType:
    path = Path(__file__).resolve().parent / "vpn-bot-wizard-lib"
    st = os.stat(path, follow_symlinks=False)
    if os.geteuid() == 0 and os.environ.get("VPN_BOT_WIZARD_SELFTEST") != "1" and (st.st_uid != 0 or st.st_mode & 0o022):
        sys.exit(f"{Path(__file__).name}: {path} must be root-owned and not group/other-writable")
    loader = importlib.machinery.SourceFileLoader("vpn_bot_wizard_lib", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


lib = _load_lib()
MODE = "update"
CHECK_LOG = "check.log"
DEPLOY_LOG = "deploy.log"
PLAN_FILE = "update-plan.json"
TARGET_MOVED = "target-moved"
BOT_UNIT = "vpn-bot.service"
MAX_COMMITS = 30
DEPLOY_OK = "===== DEPLOY OK ====="
ROLLBACK_REPORT = "===== ROLLBACK REPORT ====="
PHASE1_REPORT = "===== PHASE 1 REPORT"
# deploy_verdict of the apply step, for verify/rollback (they run as later steps).
VERDICT_FILE = "deploy-verdict.json"
NOTHING_TO_DEPLOY = "nothing to deploy"
_SCHEMA_RE = re.compile(r"^CURRENT_SCHEMA_VERSION\s*=\s*(\d+)", re.MULTILINE)


# --------------------------------------------------------------------------- #
# DEPLOY VERDICT — one rule, carried VERBATIM by scripts/vpn-relay-agent (`update`)
# and scripts/wizard/vpn-bot-wizard-update (the main server's «Обновить бота»);
# tests/test_deploy_verdict.py pins the two blocks byte-identical, the reasons
# against deploy.sh's DEPLOY_FAIL_REASONS and the bot's i18n.
# --------------------------------------------------------------------------- #
# deploy.sh's reason=<class> (its DEPLOY_FAIL_REASONS), plus the waiter's own:
# "timeout" — the deploy did not finish while the caller waited for it.
DEPLOY_REASONS = (
    "busy", "fetch", "preflight", "no_venv", "tests", "checks", "upstream", "rolled_back", "failed", "timeout",
)
_DV_RESULT = re.compile(
    r"\[deploy:result (?:ok|noop|failed step=(?P<step>[a-z_]{1,32}) reason=(?P<reason>[a-z_]{1,32}))\]"
)
_DV_WARN = re.compile(r"^\[deploy:warn (?P<code>[a-z_]{1,48})\] ?(?P<text>.*)$", re.MULTILINE)
_DV_LOG = re.compile(r"^redeploy: launching \S+ \(log: (?P<log>/\S+)\)$", re.MULTILINE)
_DV_PYTEST_SUMMARY = re.compile(r"^=+ .*\b[0-9]+ (?:failed|errors?)\b.* in [0-9.]+s.*=+$")
_DV_PYTEST_NODE = re.compile(r"^(?:FAILED|ERROR) tests/")
DV_EXCERPT_LINES = 8
DV_EXCERPT_CHARS = 300
# A FAIL row of the host invariants (deploy.sh's hc_row_text under «[deploy][WARN]»):
# «FAIL BEATEN   sshd passwordauthentication — <text>[ [<path>]]» — the finding itself.
_DV_HC_ROW = re.compile(
    r"^\[deploy\]\[WARN\]\s+FAIL\s+(?P<verdict>BEATEN|MISMATCH|LATENT)\s+(?P<family>[a-z][a-z0-9_-]{0,31})"
    r"\s+(?P<key>\S{1,128}) — (?P<text>.*?)(?: \[(?P<path>/[^\]\s]{1,300})\])?$"
)
_DV_AT_PATH = re.compile(r"^(/\S{1,300}?):[0-9]{1,6} = ")
DV_FINDINGS_MAX = 8


def _dv_guess(lines: list[str], rc: int) -> str:
    """The reason of a deploy.sh that printed no result line (one that predates the
    markers), read from its text the way an operator reads it."""
    text = "\n".join(lines)
    if rc == 124:
        return "timeout"
    if "another deploy already holds" in text:
        return "busy"
    if "ensurepip is not available" in text or re.search(r"\bpython3\.[0-9]+-venv\b", text):
        return "no_venv"
    if "===== ROLLBACK REPORT" in text:
        if re.search(r"vpn-relay-apply check failed after the restart \(exit 1[34]\b", text):
            return "upstream"
        return "rolled_back"
    if any(_DV_PYTEST_SUMMARY.match(ln) or _DV_PYTEST_NODE.match(ln) for ln in lines):
        return "tests"
    fails = [ln for ln in lines if "[deploy][FAIL] " in ln]
    if fails:
        return "fetch" if "git fetch" in fails[-1] else "checks"
    return "failed"


def _dv_excerpt(lines: list[str]) -> list[str]:
    """The lines an operator looks at first: the rollback's reason, deploy.sh's FAIL
    lines, the relay check's FAIL lines, the failed tests and pytest's summary, the
    ensurepip hint — the last DV_EXCERPT_LINES of them, each capped."""
    picked: list[str] = []
    for i, line in enumerate(lines):
        rollback_reason = (
            "[deploy][WARN] " in line and i + 1 < len(lines) and "[deploy][WARN] ROLLBACK" in lines[i + 1]
        )
        if (
            rollback_reason
            or "[deploy][FAIL] " in line
            or "FAIL: " in line
            or _DV_HC_ROW.match(line)
            or _DV_PYTEST_NODE.match(line)
            or _DV_PYTEST_SUMMARY.match(line)
            or "ensurepip is not available" in line
            or re.search(r"\bapt install python3\.[0-9]+-venv\b", line)
        ):
            text = line.strip()[:DV_EXCERPT_CHARS]
            if text not in picked:
                picked.append(text)
    return picked[-DV_EXCERPT_LINES:]


def _dv_findings(lines: list[str]) -> list[dict[str, str]]:
    """The host invariants' FAIL rows (_DV_HC_ROW) as {verdict, family, key, path, text}:
    the path the row names, else the file of «<file>:<line> = …» its text starts with."""
    found: list[dict[str, str]] = []
    for line in lines:
        m = _DV_HC_ROW.match(line.strip())
        if m is None:
            continue
        text = m.group("text").strip()[:DV_EXCERPT_CHARS]
        at = _DV_AT_PATH.match(text)
        path = m.group("path") or (at.group(1) if at else "")
        item = {"verdict": m.group("verdict"), "family": m.group("family"), "key": m.group("key"),
                "path": path, "text": text}
        if item not in found:
            found.append(item)
    return found[-DV_FINDINGS_MAX:]


def deploy_verdict(output: str, rc: int) -> dict[str, Any]:
    """Why a deploy (redeploy.sh -> deploy.sh) ended as it did, for the bot.

    ``{"reason", "step", "excerpt", "findings", "warnings", "log"}``: reason is one of
    DEPLOY_REASONS, or "" when the deploy did not fail (ok, noop); step is deploy.sh's
    step it failed in ("" when unknown); excerpt the significant lines; findings the
    host invariants' FAIL rows of a failed deploy (_dv_findings); warnings the
    ``[deploy:warn]`` findings of a deploy that succeeded ({"code", "text"}); log the
    deploy log redeploy.sh named. deploy.sh's own result line decides when there is
    one; without it the text does (a deploy.sh that predates the markers).
    """
    lines = [ln.rstrip() for ln in output.splitlines() if ln.strip()]
    found = None
    for match in _DV_RESULT.finditer(output):
        found = match
    reason = step = ""
    if rc == 124:
        reason = "timeout"
    elif found is not None:
        if found.group("reason") is not None:
            reason = found.group("reason") if found.group("reason") in DEPLOY_REASONS else "failed"
            step = found.group("step") or ""
        elif rc != 0:
            reason = "failed"
    elif rc != 0:
        reason = _dv_guess(lines, rc)
    if not step:
        steps = re.findall(r"\[deploy:step [0-9]+/[0-9]+ ([a-z_]{1,32})\]", output)
        step = steps[-1] if reason and steps else ""
    log = _DV_LOG.search(output)
    return {
        "reason": reason,
        "step": step,
        "excerpt": _dv_excerpt(lines) if reason else [],
        "findings": _dv_findings(lines) if reason else [],
        "warnings": [
            {"code": m.group("code"), "text": m.group("text").strip()[:DV_EXCERPT_CHARS]}
            for m in _DV_WARN.finditer(output)
        ],
        "log": log.group("log") if log else "",
    }
# deploy.sh's DEPLOY_STEPS, in order (the progress of a running deploy).
DEPLOY_STEPS = ("preflight", "fetch", "tests", "checks", "backup", "install", "restart", "verify")
_DV_STEP = re.compile(r"\[deploy:step [0-9]+/[0-9]+ ([a-z_]{1,32})\]")
_DV_SKIP = re.compile(r"\[deploy:skip ([a-z_]{1,32})\]")
_DV_TOTAL = re.compile(r"\[deploy:tests total=([0-9]{1,7})\]")
# pytest -q: a line of result characters, "[ NN%]" at its end once it is full.
_DV_PYTEST_LINE = re.compile(r"^([.FEsxX]+)\s*(?:\[\s*[0-9]{1,3}%\])?\s*$")


def deploy_progress(output: str) -> dict[str, Any]:
    """Where a RUNNING deploy is, from its output so far: every step of DEPLOY_STEPS
    with its state (wait / run / ok / fail / skip), the current step, and the tests
    (done of total: total from ``[deploy:tests total=N]``, done counted from pytest's
    result characters). After a relay's handover the steps start over: the LAST step
    line is the current one."""
    steps = _DV_STEP.findall(output)
    current = steps[-1] if steps else ""
    skipped = set(_DV_SKIP.findall(output))
    result = None
    for match in _DV_RESULT.finditer(output):
        result = match
    states: dict[str, str] = {}
    at = DEPLOY_STEPS.index(current) if current in DEPLOY_STEPS else -1
    for i, name in enumerate(DEPLOY_STEPS):
        if name in skipped and i <= max(at, 0):
            states[name] = "skip"
        elif i < at:
            states[name] = "ok"
        elif i == at:
            states[name] = "run"
        else:
            states[name] = "wait"
    if result is not None and current in states:
        if result.group("reason") is not None:
            states[current] = "fail"
        else:
            states = {k: ("ok" if v in ("run", "wait") and DEPLOY_STEPS.index(k) <= at else v)
                      for k, v in states.items()}
    totals = _DV_TOTAL.findall(output)
    done = sum(len(m.group(1)) for line in output.splitlines() if (m := _DV_PYTEST_LINE.match(line.strip())))
    tests: dict[str, int] = {}
    if totals or done:
        tests = {"done": done, **({"total": int(totals[-1])} if totals else {})}
    return {"step": current, "steps": states, "tests": tests}
# --- DEPLOY VERDICT (end) ---


def app() -> str:
    return str(lib.host_path(lib.APP_DIR))


def git(ctx: Any, *args: str, timeout: int = 120) -> tuple[int, str]:
    return ctx.run(["git", "-C", app(), *args], timeout=timeout)


def schema_of(ctx: Any, rev: str) -> str:
    rc, text = git(ctx, "show", f"{rev}:db/database.py")
    m = _SCHEMA_RE.search(text) if rc == 0 else None
    return m.group(1) if m else "?"


def live_schema() -> str:
    env = lib.env_file_values(lib.host_path(f"{lib.APP_DIR}/.env"))
    db = lib.host_path(env.get("DB_PATH", "").strip() or f"{lib.APP_DIR}/data/vpn.db")
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        try:
            row = conn.execute("SELECT value FROM schema_meta WHERE key='schema_version'").fetchone()
        finally:
            conn.close()
    except sqlite3.Error:
        return "?"
    return str(row[0]) if row else "?"


PROGRESS_EVERY = 2.0


def run_streaming(ctx: Any, argv: list[str], *, env: dict[str, str], timeout: int) -> tuple[int, str]:
    """ctx.run for redeploy.sh, reading its output WHILE it runs: every PROGRESS_EVERY
    seconds a ``deploy`` event carries deploy_progress of the output so far — the
    steps and the tests the bot shows (bot/wizard_views.py). The same tool fence and
    environment as the library's run_cmd; (exit code, output), 124 on a timeout."""
    exe = lib.tool_allowed(argv[0])
    if exe is None:
        return 127, f"{argv[0]}: refused (VPN_BOT_WIZARD_SELFTEST: not a stub)"
    run_env = {k: v for k, v in os.environ.items() if k not in ("LANGUAGE", "LC_MESSAGES")}
    run_env["LC_ALL"] = "C"
    run_env.update(env)
    try:
        proc = subprocess.Popen(  # noqa: S603 — argv list, never a shell
            [exe, *argv[1:]], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=run_env,
        )
    except FileNotFoundError:
        return 127, f"{argv[0]}: not found"
    assert proc.stdout is not None
    fd = proc.stdout.fileno()
    chunks: list[bytes] = []
    deadline = time.monotonic() + timeout
    told, last = 0.0, None
    rc: int | None = None

    def text() -> str:
        return b"".join(chunks).decode("utf-8", errors="replace")

    while rc is None:
        left = deadline - time.monotonic()
        if left <= 0:
            proc.kill()
            proc.wait()
            rc = 124
            break
        ready, _, _ = select.select([fd], [], [], min(left, PROGRESS_EVERY))
        if ready:
            data = os.read(fd, 65536)
            if not data:
                rc = proc.wait()
                break
            chunks.append(data)
        if time.monotonic() - told >= PROGRESS_EVERY:
            told = time.monotonic()
            progress = deploy_progress(text())
            if progress != last:
                last = progress
                with contextlib.suppress(Exception):
                    ctx.event("deploy", progress=progress)
    out = text() + (f"\n{argv[0]}: timed out after {timeout}s" if rc == 124 else "")
    with contextlib.suppress(Exception):
        ctx.event("deploy", progress=deploy_progress(out))
    ctx.log.write(f"$ {' '.join(argv)}  (exit {rc})\n{out.rstrip()}")
    return rc, out


def redeploy(ctx: Any, *, check: bool, timeout: int) -> tuple[int, str]:
    env = {"REDEPLOY_ATTACH": "pipe"}
    if check:
        env["CHECK"] = "1"
    if ctx.params.get("force") == "1":
        env["FORCE"] = "1"
    ctx.say("CHECK=1 redeploy (Phase 1, read-only)" if check else "redeploy: deploy.sh restarts the bot; the run continues in its own unit")
    return run_streaming(ctx, ["bash", f"{app()}/scripts/redeploy.sh"], env=env, timeout=timeout)


def save(ctx: Any, name: str, text: str) -> None:
    lib.write_private(lib.artifact_path(ctx.run_id, name), lib.redact_text(text).encode("utf-8"))


def read_artifact(ctx: Any, name: str) -> str:
    try:
        return lib.artifact_path(ctx.run_id, name).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def report_block(text: str, marker: str) -> str:
    """The report printed after *marker*, up to the closing ===== line."""
    start = text.rfind(marker)
    if start < 0:
        return ""
    lines = text[start:].splitlines()
    out = [lines[0]]
    for line in lines[1:]:
        out.append(line)
        if line.startswith("====="):
            break
    return "\n".join(out[:40])


# --------------------------------------------------------------------------- #
def step_plan(ctx: Any) -> int:
    ctx.say("git fetch origin main")
    rc, out = git(ctx, "fetch", "origin", "main", timeout=300)
    if rc != 0:
        ctx.event("plan", text=f"git fetch origin main failed (exit {rc}):\n{out[-800:]}")
        return 1
    _, head = git(ctx, "rev-parse", "--short", "HEAD")
    _, tip = git(ctx, "rev-parse", "--short", "origin/main")
    head, tip = head.strip(), tip.strip()
    _, target = git(ctx, "rev-parse", "origin/main")
    # The revision this plan describes: apply deploys it or nothing (see step_apply).
    save_plan(ctx, target.strip())
    _, head_full = git(ctx, "rev-parse", "HEAD")
    _, count = git(ctx, "rev-list", "--count", "HEAD..origin/main")
    _, ahead = git(ctx, "rev-list", "--count", "origin/main..HEAD")
    _, log = git(ctx, "log", "--oneline", "--no-decorate", f"--max-count={MAX_COMMITS}", "HEAD..origin/main")
    schema_head, schema_tip, schema_live = schema_of(ctx, "HEAD"), schema_of(ctx, "origin/main"), live_schema()
    n = int(count.strip()) if count.strip().isdigit() else 0
    local_only = int(ahead.strip()) if ahead.strip().isdigit() else 0
    lines = [f"HEAD {head} → origin/main {tip}: {n} commit(s)"]
    lines += [f"  {c}" for c in log.strip().splitlines()]
    if n > MAX_COMMITS:
        lines.append(f"  … and {n - MAX_COMMITS} more")
    if local_only:
        # HEAD..origin/main does not see these (git rev-list: A..B is ^A B), and
        # deploy.sh resets the checkout to origin/main: they are dropped.
        lines.append(
            f"⚠ the checkout has {local_only} commit(s) that are NOT on origin/main — "
            "the deploy resets it to origin/main and they are gone"
        )
    if schema_tip != schema_head:
        lines.append(f"schema migration: {schema_head} → {schema_tip} (live {schema_live})")
    else:
        lines.append(f"schema: no migration ({schema_tip}, live {schema_live})")
    # The same test deploy.sh makes (HEAD == origin/main), never "no incoming commits":
    # a checkout AHEAD of origin/main has none and is still not at origin/main.
    if head_full.strip() and head_full.strip() == target.strip() and ctx.params.get("force") != "1":
        lines.append("already at origin/main — nothing to deploy")
        ctx.event("plan", text="\n".join(lines), noop=True, commits=0, schema_from=schema_head, schema_to=schema_tip)
        return 0
    rc, out = redeploy(ctx, check=True, timeout=lib.mode_of(MODE).timeout("plan") - 120)
    save(ctx, CHECK_LOG, out)
    phase1_ok = rc == 0 and PHASE1_REPORT in out
    verdict = deploy_verdict(out, rc)
    if phase1_ok:
        lines.append("CHECK (deploy.sh Phase 1): OK — the full report is in the run log")
    else:
        tail = "\n".join(out.strip().splitlines()[-12:])
        lines.append(f"CHECK (deploy.sh Phase 1): FAILED (exit {rc})\n{tail}")
    ctx.event(
        "plan",
        text="\n".join(lines),
        noop=False,
        commits=n,
        schema_from=schema_head,
        schema_to=schema_tip,
        check_ok=phase1_ok,
        **({} if phase1_ok else _failure_fields(verdict, "failed")),
    )
    return 0 if phase1_ok else 1


def _failure_fields(verdict: dict[str, Any], default: str) -> dict[str, Any]:
    """The cause of a failed deploy for the bot (the event's reason/step/excerpt/log)."""
    return {
        "reason": verdict["reason"] or default,
        "fail_step": verdict["step"],
        "excerpt": verdict["excerpt"],
        "findings": verdict.get("findings") or [],
        "deploy_log": verdict["log"],
    }


def save_plan(ctx: Any, target: str) -> None:
    lib.write_private(lib.artifact_path(ctx.run_id, PLAN_FILE), json.dumps({"target": target}).encode())


def planned_target(ctx: Any) -> str:
    try:
        data = json.loads(read_artifact(ctx, PLAN_FILE) or "{}")
    except ValueError:
        return ""
    target = data.get("target") if isinstance(data, dict) else None
    return target if isinstance(target, str) and re.fullmatch(r"[0-9a-f]{40,64}", target) else ""


def refuse_moved(ctx: Any, text: str, verdict: str) -> int:
    ctx.event("result", text=text, verdict=verdict)
    lib.write_private(lib.artifact_path(ctx.run_id, TARGET_MOVED), text.encode())
    print(text, file=sys.stderr)
    return 1


def step_apply(ctx: Any) -> int:
    target = planned_target(ctx)
    if not target:
        return refuse_moved(ctx, "no plan recorded for this run — nothing deployed; start the update again", "no_plan")
    rc, out = git(ctx, "fetch", "origin", "main", timeout=300)
    if rc != 0:
        return refuse_moved(ctx, f"git fetch origin main failed (exit {rc}) — nothing deployed", "fetch_failed")
    _, now = git(ctx, "rev-parse", "origin/main")
    if now.strip() != target:
        return refuse_moved(
            ctx,
            f"origin/main moved after the plan ({target[:7]} → {now.strip()[:7]}) — nothing deployed; "
            "start the update again to see the new plan",
            "target_moved",
        )
    rc, out = redeploy(ctx, check=False, timeout=lib.mode_of(MODE).timeout("apply") - 120)
    save(ctx, DEPLOY_LOG, out)
    save(ctx, VERDICT_FILE, json.dumps(deploy_verdict(out, rc)))
    if DEPLOY_OK in out or NOTHING_TO_DEPLOY in out:
        return 0
    print(f"redeploy did not report DEPLOY OK (exit {rc})", file=sys.stderr)
    return 1


def saved_verdict(ctx: Any) -> dict[str, Any]:
    """deploy_verdict of the apply step (saved next to the deploy log), or a blank one."""
    try:
        data = json.loads(read_artifact(ctx, VERDICT_FILE) or "{}")
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    blank: dict[str, Any] = {"reason": "", "step": "", "excerpt": [], "findings": [], "warnings": [], "log": ""}
    return {**blank, **{k: v for k, v in data.items() if k in blank}}


def step_verify(ctx: Any) -> int:
    out = read_artifact(ctx, DEPLOY_LOG)
    if DEPLOY_OK in out:
        block = report_block(out, DEPLOY_OK)
        deployed = re.search(r"deployed\s*:\s*\S+\s*->\s*([0-9a-f]{4,64})", out)
        target = planned_target(ctx)
        if deployed and target and not target.startswith(deployed.group(1)):
            block += f"\n⚠ deployed {deployed.group(1)}, the plan was for {target[:7]} (origin/main moved during the deploy)"
    elif NOTHING_TO_DEPLOY in out:
        block = "HEAD already at origin/main — nothing to deploy"
    else:
        print("no DEPLOY OK in the deploy output", file=sys.stderr)
        return 1
    rc, state = ctx.run(["systemctl", "is-active", BOT_UNIT])
    if state.strip() != "active":
        print(f"{BOT_UNIT} is {state.strip() or 'unknown'} after the deploy", file=sys.stderr)
        return 1
    warnings = saved_verdict(ctx)["warnings"]
    ctx.event("result", text=block, verdict="deploy_ok", **({"warnings": warnings} if warnings else {}))
    return 0


def step_rollback(ctx: Any) -> int:
    if read_artifact(ctx, TARGET_MOVED):
        return 1  # apply deployed nothing; its result line already says why
    out = read_artifact(ctx, DEPLOY_LOG)
    block = report_block(out, ROLLBACK_REPORT)
    _, state = ctx.run(["systemctl", "is-active", BOT_UNIT])
    running = state.strip() == "active"
    cause = _failure_fields(saved_verdict(ctx), "rolled_back" if block else "failed")
    if block:
        ctx.event("result", text=block + f"\n{BOT_UNIT}: {state.strip() or 'unknown'}", verdict="rolled_back", **cause)
        return 0 if running else 1
    ctx.event(
        "result",
        text=f"no ROLLBACK REPORT: deploy.sh stopped before Phase 2 (nothing changed) or did not finish — read the run log. {BOT_UNIT}: {state.strip() or 'unknown'}",
        verdict="no_report",
        **cause,
    )
    return 1


if __name__ == "__main__":
    sys.exit(lib.contract_main(MODE, {"plan": step_plan, "apply": step_apply, "verify": step_verify, "rollback": step_rollback}, sys.argv[1:]))
