class Items:
    def __init__(self, ctx: Any) -> None:
        self.ctx = ctx
        self.counts = {"green": 0, "yellow": 0, "red": 0}

    def add(self, level: str, key: str, text: str, msg: str = "", args: dict[str, str] | None = None) -> None:
        self.counts[level] += 1
        fields: dict[str, Any] = {"level": level, "key": key, "text": text}
        if msg:
            # Status.emit redacts only top-level strings: redact the values here.
            fields["msg"] = msg
            fields["args"] = {k: lib.redact_text(v) for k, v in (args or {}).items()}
        self.ctx.event("item", **fields)
        self.ctx.log.write(f"[{level}] {key}: {text}")

    def say(self, level: str, key: str, msg: str, **args: object) -> None:
        """An item in the bot's language: MESSAGES[msg] is the English text."""
        values = {k: str(v) for k, v in args.items()}
        self.add(level, key, MESSAGES[msg].format_map(values), msg=msg, args=values)


def app_env() -> dict[str, str]:
