def check_listeners(ctx: Any, items: Items) -> None:
    helper = lib.host_path(UFW_HELPER) if lib.SELFTEST else Path(UFW_HELPER)
    if not lib.SELFTEST and not os.access(helper, os.X_OK):
        items.add("yellow", "listeners", f"{UFW_HELPER} is not installed — listeners not checked (run a deploy)")
        return
    rc, out = ctx.run(["vpn-bot-ufw-apply" if lib.SELFTEST else UFW_HELPER, "listeners"], timeout=120)
    verdict = ""
    fails = []
    for line in out.splitlines():
        if line.startswith("listeners="):
            verdict = line.split("=", 1)[1].strip()
        elif line.startswith("listener=FAIL|"):
            parts = line.split("|")
            fails.append(f"{parts[2]}/{parts[1].split('=')[-1]} on {parts[3]}" if len(parts) > 3 else line)
    if verdict == "ok":
        items.add("green", "listeners", "every public listener is allowed by the firewall set or declared closed")
    elif verdict == "fail":
        items.add("red", "listeners", "not in the firewall set and not declared closed: " + ", ".join(fails[:8]))
    else:
        items.add("yellow", "listeners", f"listener check gave no verdict (exit {rc})")


def warp_deployed(ctx: Any, conf: str = WARP_CONF) -> bool:
    if lib.host_path(conf).exists():
        return True
    rc, out = ctx.run(["systemctl", "is-enabled", "warp-routes.service"])
    return rc == 0 and out.strip() in ("enabled", "enabled-runtime", "static")


def env_bool(env: dict[str, str], name: str) -> bool | None:
    """config/settings.py `_bool` without the exception: None = unset or not a boolean."""
    raw = env.get(name, "").strip().lower()
    return True if raw in _TRUE else False if raw in _FALSE else None


def proxy_egress_flag(env: dict[str, str]) -> bool:
    """WARP_PROXY_EGRESS_ENABLED, falling back to the legacy WARP_PROXY_EGRESS (as the bot)."""
    if env.get("WARP_PROXY_EGRESS_ENABLED", "").strip():
        return env_bool(env, "WARP_PROXY_EGRESS_ENABLED") is True
    return env_bool(env, "WARP_PROXY_EGRESS") is True


def uninstalled(proto: str) -> bool:
    return bool(lib.host_path(f"{UNINSTALLED_DIR}/{proto}").exists())


def warp_settings_enabled(env: dict[str, str]) -> bool | None:
    """warp_settings.enabled, read-only (mode=ro: the bot owns the WAL). None = unknown."""
    db = lib.host_path(env.get("DB_PATH", "").strip() or f"{lib.APP_DIR}/data/vpn.db")
    if not db.is_file():
        return None
    try:
        conn = sqlite3.connect(f"file:{quote(str(db))}?mode=ro", uri=True, timeout=5)
        try:
            row = conn.execute("SELECT enabled FROM warp_settings WHERE id = 1").fetchone()
        finally:
            conn.close()
    except sqlite3.Error:
        return None
    return None if row is None else bool(row[0])


def ipv4(value: str) -> str | None:
    try:
        return str(ipaddress.IPv4Address(value.strip()))
    except ValueError:
        return None


def read_tunnel_address(path: Path) -> str | None:
    """warp/proxy_egress.py read_tunnel_address: the address the bot puts in sendThrough."""
    try:
        match = _ADDRESS_RE.search(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError):
        return None
    if match is None:
        return None
    for token in match.group(1).split(","):
        found = ipv4(token.split("/")[0])
        if found:
            return found
    return None


def split_prefixes(path: Path) -> list[ipaddress.IPv4Network]:
    """The routes `vpn-bot-warp-split apply` installs from the list: IPv4, no comments,
    no default route, each network once (the bot's read_list, canonical)."""
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    out: list[ipaddress.IPv4Network] = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        try:
            net = ipaddress.ip_network(line, strict=False)
        except ValueError:
            continue
        if isinstance(net, ipaddress.IPv4Network) and net.prefixlen and net not in out:
            out.append(net)
    return out


def table_routes(text: str, iface: str) -> tuple[bool, int, int]:
    """(a default via iface, `<prefix> dev iface` routes, every route via iface) in table T.

    The prefix count is the filter of the split helpers ($1 != default, $2 == dev,
    $3 == iface); "every route" also counts `<prefix> via <gw> dev iface`."""
    default, prefixes, total = False, 0, 0
    for line in text.splitlines():
        tok = line.split()
        if not any(tok[i] == "dev" and tok[i + 1] == iface for i in range(len(tok) - 1)):
            continue
        total += 1
        if tok[0] == "default":
            default = True
        elif len(tok) >= 3 and tok[1] == "dev":
            prefixes += 1
    return default, prefixes, total


def split_state_status(ctx: Any, iface: str) -> dict[str, str] | None:
    """`vpn-bot-warp-split-state status` (tunnel_up, n_table, marker); None = not available."""
    if not lib.SELFTEST and not os.access(SPLIT_STATE_HELPER, os.X_OK):
        return None
    argv = ["vpn-bot-warp-split-state" if lib.SELFTEST else SPLIT_STATE_HELPER, "status"]
    rc, out = ctx.run(argv, env={"WARP_IFACE": iface}, timeout=30)
    if rc != 0:
        return None
    facts = {}
    for line in out.splitlines():
        key, sep, value = line.strip().partition("=")
        if sep:
            facts[key.strip()] = value.strip()
    return facts


def rule_present(rules: str, src: str, table: int) -> bool:
    for line in rules.splitlines():
        tok = line.split()
        if "from" in tok and "lookup" in tok:
            i, j = tok.index("from"), tok.index("lookup")
            if tok[i + 1 : i + 2] == [src] and tok[j + 1 : j + 2] == [str(table)]:
                return True
    return False


def iface_addresses(ctx: Any) -> dict[str, tuple[bool, list[str]]] | None:
    """`ip -4 -br addr show`: interface → (up, IPv4 addresses); None = not readable.
    WireGuard reports its operstate as UNKNOWN when up."""
    rc, out = ctx.run(["ip", "-4", "-br", "addr", "show"])
    found: dict[str, tuple[bool, list[str]]] = {}
    if rc != 0:
        return None
    for line in out.splitlines():
        tok = line.split()
        if len(tok) < 2:
            continue
        addrs = [a for a in (ipv4(t.split("/")[0]) for t in tok[2:]) if a]
        found[tok[0].split("@", 1)[0]] = (tok[1] in ("UP", "UNKNOWN"), addrs)
    return found


def egress_consumers(env: dict[str, str], iface: str, addrs: dict[str, tuple[bool, list[str]]], tunnel_ip: str | None) -> tuple[dict[str, set[str]], bool]:
    """Address → the proxies sending from it (xray sendThrough, danted external), and
    whether the live xray config was read at all."""
    users: dict[str, set[str]] = {}
    xray_read = False
    if not uninstalled("xray"):
        try:
            cfg = json.loads(lib.host_path(env.get("XRAY_CONFIG_PATH", "").strip() or XRAY_CONFIG).read_text(encoding="utf-8"))
            xray_read = True
        except (OSError, ValueError):
            cfg = None
        outbounds = cfg.get("outbounds") if isinstance(cfg, dict) else None
        for ob in outbounds if isinstance(outbounds, list) else []:
            src = ob.get("sendThrough") if isinstance(ob, dict) else None
            addr = ipv4(src) if isinstance(src, str) else None
            if addr:
                users.setdefault(addr, set()).add("xray")
    if not uninstalled("socks5"):
        try:
            text = lib.host_path(DANTE_CONF).read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        for line in text.splitlines():
            m = re.match(r"^\s*external\s*:\s*(\S+)", line.split("#", 1)[0])
            if m is None:
                continue
            addr = ipv4(m.group(1))
            if addr:
                users.setdefault(addr, set()).add("danted")
            elif m.group(1) == iface:  # `external: out-warp` binds whatever the interface holds
                for a in addrs.get(iface, (False, []))[1] or ([tunnel_ip] if tunnel_ip else []):
                    users.setdefault(a, set()).add("danted")
    return users, xray_read


def route_dev(ctx: Any, probe: str, src: str) -> str | None:
    """The device `ip -4 route get <probe> from <src>` resolves to — a FIB lookup through
    the policy rules, nothing is sent. None = no route."""
    rc, out = ctx.run(["ip", "-4", "route", "get", probe, "from", src])
    tok = out.split("\n", 1)[0].split() if rc == 0 else []
    if not tok or tok[0] in ("unreachable", "prohibit", "blackhole", "throw"):
        return None
    return next((tok[i + 1] for i in range(len(tok) - 1) if tok[i] == "dev"), None)


def default_wan(ctx: Any) -> str | None:
    rc, out = ctx.run(["ip", "-4", "route", "show", "default"])
    for line in str(out).splitlines() if rc == 0 else []:
        tok = line.split()
        if tok[:1] == ["default"] and "dev" in tok[:-1]:
            return tok[tok.index("dev") + 1]
    return None


def snat_covers(rules: str, src: str, dev: str) -> bool:
    """Does `iptables -t nat -S POSTROUTING` carry a MASQUERADE/SNAT that rewrites
    packets from `src` leaving via `dev`? Only a plain rule counts: `-s` (covering src
    or absent), `-o` (dev, an `eth+` wildcard, or absent), a comment and the target's
    own options. Any other match (`-m mark`, `-d`, `!` …) is not a rule for src."""
    valued = {"-s": "s", "--source": "s", "-o": "o", "--out-interface": "o", "-j": "j", "--comment": "c"}
    target_opts = {"--to-source": 1, "--to-ports": 1, "--random": 0, "--random-fully": 0, "--persistent": 0}
    for line in rules.splitlines():
        try:
            tok = shlex.split(line)
        except ValueError:
            continue
        if tok[:2] != ["-A", "POSTROUTING"]:
            continue
        opts: dict[str, str] = {}
        i, plain = 2, True
        while i < len(tok):
            t = tok[i]
            if t in valued and i + 1 < len(tok):
                opts[valued[t]] = tok[i + 1]
                i += 2
            elif t == "-m" and tok[i + 1 : i + 2] == ["comment"]:
                i += 2
            elif t in target_opts:
                i += 1 + target_opts[t]
            else:
                plain = False
                break
        if not plain or opts.get("j") not in ("MASQUERADE", "SNAT"):
            continue
        out = opts.get("o")
        if out is not None and out != dev and not (out.endswith("+") and dev.startswith(out[:-1])):
            continue
        try:
            if "s" in opts and ipaddress.IPv4Address(src) not in ipaddress.IPv4Network(opts["s"], strict=False):
                continue
        except ValueError:
            continue
        return True
    return False


def check_warp(ctx: Any, items: Items) -> None:
    env = app_env()
    conf = env.get("WARP_CONFIG_PATH", "").strip() or WARP_CONF
    if not warp_deployed(ctx, conf):
        items.say("green", "warp", "warp_not_deployed")
        return
    iface = env.get("WARP_INTERFACE", "").strip() or WARP_IFACE
    marker = lib.host_path(env.get("WARP_SPLIT_DISABLED_MARKER_PATH", "").strip() or SPLIT_MARKER).exists()
    want = [] if marker else split_prefixes(lib.host_path(env.get("WARP_SPLIT_LIST_PATH", "").strip() or SPLIT_LIST))
    mode = "direct" if marker else "selective" if want else "full"
    rc, out = ctx.run(["awg", "show", iface, "fwmark"])
    fw = out.strip()
    table = int(fw, 16) if rc == 0 and re.fullmatch(r"0x[0-9a-fA-F]+", fw) else None
    enabled = warp_settings_enabled(env)
    if enabled is False:
        # Turned off in the bot: nothing to demand of the routes. In observer mode
        # systemd may keep out-warp up all the same — a note, never a red.
        items.say("green", "warp", "warp_disabled_up" if table is not None else "warp_disabled", iface=iface)
    elif table is None:
        items.say("red", "warp", "warp_down" if enabled else "warp_down_unknown", iface=iface)
    else:
        check_warp_routes(ctx, items, env, iface, table, mode, len(want))
    # Independent of warp_settings: a proxy bound to the tunnel address uses out-warp
    # whatever the bot's toggle says.
    check_warp_egress(ctx, items, env, conf, iface, mode, want)


def check_warp_routes(ctx: Any, items: Items, env: dict[str, str], iface: str, table: int, mode: str, n_want: int) -> None:
    rc, routes = ctx.run(["ip", "-4", "route", "show", "table", str(table)])
    # A table nothing was ever added to is "FIB table does not exist": empty.
    default, prefixes, total = table_routes(routes if rc == 0 else "", iface)
    facts = split_state_status(ctx, iface) or {}
    n_table = int(facts["n_table"]) if facts.get("n_table", "").isdigit() else prefixes
    if mode == "direct":
        if default:
            items.say("yellow", "warp", "warp_direct_default", table=table, iface=iface)
        elif total:
            items.say("yellow", "warp", "warp_direct_drift", table=table, iface=iface, count=total)
        else:
            items.say("green", "warp", "warp_direct_ok", table=table, iface=iface)
    elif mode == "selective":
        if default:
            items.say("yellow", "warp", "warp_selective_default", table=table, iface=iface, want=n_want)
        elif n_table != n_want:
            items.say("yellow", "warp", "warp_selective_drift", table=table, iface=iface, want=n_want, count=n_table)
        else:
            items.say("green", "warp", "warp_selective_ok", table=table, iface=iface, count=n_table)
    elif default:
        items.say("green", "warp", "warp_full_ok", table=table, iface=iface)
    else:
        items.say("red", "warp", "warp_full_missing", table=table, iface=iface)
    if uninstalled("awg"):
        return  # no client subnet: its rule is nobody's business
    try:
        subnet = str(ipaddress.IPv4Network(env.get("AWG_NETWORK", "").strip() or AWG_NETWORK, strict=False))
    except ValueError:
        subnet = AWG_NETWORK
    rc, rules = ctx.run(["ip", "-4", "rule", "show"])
    if rc == 0 and rule_present(rules, subnet, table):
        items.say("green", "warp:rule", "warp_rule_ok", subnet=subnet, table=table)
    elif mode == "direct":
        items.say("yellow", "warp:rule", "warp_rule_missing_direct", subnet=subnet, table=table)
    else:
        items.say("red", "warp:rule", "warp_rule_missing", subnet=subnet, table=table)


def check_warp_egress(ctx: Any, items: Items, env: dict[str, str], conf: str, iface: str, mode: str, want: list[ipaddress.IPv4Network]) -> None:
    tunnel_ip = read_tunnel_address(lib.host_path(conf))
    addrs = iface_addresses(ctx)
    if addrs is None:
        # Without the addresses every consumer would look "not on out-warp": a false red.
        items.say("yellow", "warp:egress", "warp_egress_addrs_unreadable")
        return
    users, xray_read = egress_consumers(env, iface, addrs, tunnel_ip)
    owner = {a: name for name, (_, al) in addrs.items() for a in al}
    # An address on another interface (a second public IP, say) is not WARP's.
    bound = {a: who for a, who in users.items() if owner.get(a) in (None, iface)}
    if not bound:
        if proxy_egress_flag(env) and tunnel_ip is None:
            items.say("yellow", "warp:egress", "warp_egress_no_address", conf=conf)
        elif proxy_egress_flag(env) and xray_read:
            items.say("yellow", "warp:egress", "warp_egress_unused", addr=tunnel_ip)
        return
    wan = default_wan(ctx)
    rc_nat, nat = ctx.run(["iptables", "-t", "nat", "-S", "POSTROUTING"])
    probe_out = next((p for p in PROBE_IPS if not any(ipaddress.IPv4Address(p) in n for n in want)), None)
    for addr in sorted(bound):
        names = sorted(bound[addr], key=list(EGRESS_PROTOS).index)
        who, protos = "/".join(names), "/".join(EGRESS_PROTOS[n] for n in names)
        up, on_iface = addrs.get(iface, (False, []))
        if addr not in on_iface:
            items.say("red", "warp:egress", "warp_egress_addr_missing", who=who, addr=addr, iface=iface)
        elif not up:
            items.say("red", "warp:egress", "warp_egress_iface_down", who=who, addr=addr, iface=iface)
        elif wan is None:
            items.say("yellow", "warp:egress", "warp_egress_no_wan", who=who, addr=addr)
        elif rc_nat != 0:
            items.say("yellow", "warp:egress", "warp_egress_nat_unreadable", who=who, addr=addr)
        else:
            judge_egress(ctx, items, mode, addr=addr, protos=protos, iface=iface, wan=wan, nat=nat, want=want, probe_out=probe_out)


def judge_egress(ctx: Any, items: Items, mode: str, *, addr: str, protos: str, iface: str, wan: str, nat: str, want: list[ipaddress.IPv4Network], probe_out: str | None) -> None:
    """One address on an up out-warp: does the split mode's path out exist, with NAT?"""
    def wrong(probe: str, got: str | None, expected: str) -> None:
        items.say("red", "warp:egress", "warp_egress_route", protos=protos, addr=addr, probe=probe, got=got or "—", want=expected)

    def via_warp(probe: str) -> bool:
        got = route_dev(ctx, probe, addr)
        if got != iface:
            wrong(probe, got, iface)
        elif not snat_covers(nat, addr, iface):
            items.say("red", "warp:egress", "warp_egress_warp_no_nat", protos=protos, addr=addr, iface=iface)
        else:
            return True
        return False

    def via_wan(probe: str) -> bool:
        got = route_dev(ctx, probe, addr)
        if got == iface and mode == "direct":
            items.say("yellow", "warp:egress", "warp_egress_direct_via_warp", protos=protos, addr=addr, iface=iface, probe=probe)
        elif got != wan:
            wrong(probe, got, wan)
        elif not snat_covers(nat, addr, wan):
            items.say("red", "warp:egress", "warp_egress_no_snat", protos=protos, addr=addr, wan=wan)
        else:
            return True
        return False

    probe = probe_out or PROBE_IPS[0]
    if mode == "full":
        if via_warp(probe):
            items.say("green", "warp:egress", "warp_egress_full_ok", protos=protos, addr=addr, iface=iface, probe=probe)
    elif mode == "direct":
        if via_wan(probe):
            items.say("green", "warp:egress", "warp_egress_direct_ok", protos=protos, addr=addr, wan=wan, probe=probe)
    else:
        first = want[0]
        probe_in = str(first.network_address + 1 if first.num_addresses > 2 else first.network_address)
        if via_warp(probe_in) and (probe_out is None or via_wan(probe_out)):
            items.say("green", "warp:egress", "warp_egress_selective_ok", protos=protos, addr=addr, iface=iface, wan=wan, probe_in=probe_in, probe=probe_out or "—")


def check_failed_units(ctx: Any, items: Items) -> None:
    rc, out = ctx.run(["systemctl", "--failed", "--plain", "--no-legend", "--no-pager"])
    if rc != 0:
        items.add("yellow", "failed_units", f"systemctl --failed did not answer (exit {rc})")
        return
    failed = [line.split()[0] for line in out.splitlines() if line.strip()]
    if failed:
        items.add("red", "failed_units", "failed units: " + ", ".join(failed[:10]))
    else:
        items.add("green", "failed_units", "no failed units")


def cert_not_after(ctx: Any, path: Path) -> float | None:
    rc, out = ctx.run(["openssl", "x509", "-noout", "-enddate", "-in", str(path)])
    m = re.search(r"notAfter=(.+)", out)
    if rc != 0 or not m:
        return None
    try:
        return float(calendar.timegm(time.strptime(m.group(1).strip().replace(" GMT", ""), "%b %d %H:%M:%S %Y")))
    except ValueError:
        return None


def judge_cert(ctx: Any, items: Items, key: str, label: str, path: Path, extra: str = "") -> str:
    not_after = cert_not_after(ctx, path)
    if not_after is None:
        items.add("yellow", key, f"{label}: cannot read the expiry of {path}")
        return "yellow"
    days = (not_after - time.time()) / 86400
    level = "red" if days < CERT_RED_DAYS else "yellow" if days < CERT_YELLOW_DAYS else "green"
    when = time.strftime("%Y-%m-%d", time.gmtime(not_after))
    items.add(level, key, f"{label}: {days:.0f} days left (until {when}){extra}")
    return level


def acme_domain_dirs() -> list[tuple[str, Path, dict[str, str]]]:
    home = lib.host_path(ACME_HOME)
    found: list[tuple[str, Path, dict[str, str]]] = []
    if not home.is_dir():
        return found
    for d in sorted(home.iterdir()):
        if not d.is_dir() or d.name in ("ca", "deploy", "dnsapi", "notify", "http.header"):
            continue
        domain = d.name[:-4] if d.name.endswith("_ecc") else d.name
        conf = d / f"{domain}.conf"
        if conf.is_file():
            found.append((domain, d, _acme_conf(conf)))
    return found


def _acme_conf(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)='?(.*?)'?\s*$", line)
        if m:
            values[m.group(1)] = m.group(2)
    return values


def check_certs(ctx: Any, items: Items) -> None:
    seen = 0
    for domain, d, conf in acme_domain_dirs():
        seen += 1
        reload_cmd = conf.get("Le_ReloadCmd", "").strip()
        cer = d / f"{domain}.cer"
        if not reload_cmd:
            items.add("yellow", f"cert:{domain}:reload", f"{domain}: acme.sh has no reloadcmd — a renewed certificate is not picked up by nginx/hysteria/subscription")
        else:
            items.add("green", f"cert:{domain}:reload", f"{domain}: acme.sh reloadcmd is set")
        if cer.is_file():
            judge_cert(ctx, items, f"cert:{domain}", domain, cer)
        else:
            items.add("yellow", f"cert:{domain}", f"{domain}: {cer.name} is missing in {d}")
    certs = list(FIXED_CERTS)
    sub = app_env().get("SUBSCRIPTION_TLS_CERT", "").strip()
    if sub:
        certs.append(sub)
    for raw in certs:
        path = lib.host_path(raw)
        if path.is_file():
            seen += 1
            judge_cert(ctx, items, f"cert:{raw}", raw, path)
    if not seen:
        items.add("green", "certs", "no acme.sh certificate and no TLS certificate file on this host")


def parse_registry(text: str, role: str) -> list[tuple[str, str, str]]:
    start = text.find("OUT_OF_REPO_HELPERS=(")
    if start < 0:
        return []
    out = []
    for line in text[start:].splitlines()[1:]:
        if line.rstrip() == ")":
            break
        m = _REGISTRY_RE.match(line)
        if m is None:
            continue
        if (m.group(4) or "main") != role:
            continue
        out.append((m.group(1), m.group(2), m.group(3) or "absent-ok"))
    return out


def check_helpers(ctx: Any, items: Items) -> None:
    app = lib.host_path(lib.APP_DIR)
    deploy = app / "scripts" / "deploy.sh"
    try:
        text = deploy.read_text(encoding="utf-8", errors="replace")
    except OSError:
        items.add("yellow", "helpers", f"{deploy} is not readable — helper drift not checked")
        return
    role = app_env().get("NODE_ROLE", "").strip() or "main"
    drift, missing = [], []
    entries = parse_registry(text, role)
    for src_rel, dst, policy in entries:
        src, installed = app / src_rel, lib.host_path(dst)
        if not installed.exists():
            if policy == "required":
                missing.append(Path(dst).name)
            continue
        try:
            same = src.read_bytes() == installed.read_bytes()
        except OSError:
            same = False
        if not same:
            drift.append(Path(dst).name)
    if missing:
        items.add("red", "helpers", "required helper(s) not installed: " + ", ".join(missing) + " — run a deploy")
    if drift:
        items.add("yellow", "helpers", "installed copy differs from the checkout: " + ", ".join(drift) + " — the next deploy refreshes them")
    if not missing and not drift:
        items.add("green", "helpers", f"{len(entries)} out-of-repo helper(s) of role {role} match the checkout")


def _owner(st: os.stat_result) -> str:
    try:
        return pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        return str(st.st_uid)


def check_perms(ctx: Any, items: Items) -> None:
    env = app_env()
    db = lib.host_path(env.get("DB_PATH", "").strip() or f"{lib.APP_DIR}/data/vpn.db")
    try:
        pwd.getpwnam("vpn-bot")
        want_owner = "vpn-bot"
    except KeyError:
        want_owner = ""
    problems, ok = [], []
    for path, max_mode in ((db.parent, 0o700), (db, 0o600)):
        try:
            st = os.stat(path, follow_symlinks=False)
        except FileNotFoundError:
            problems.append(f"{path} is missing")
            continue
        mode = st.st_mode & 0o777
        owner = _owner(st)
        if mode & ~max_mode:
            problems.append(f"{path} mode {mode:04o} (want {max_mode:04o})")
        elif want_owner and not lib.SELFTEST and owner != want_owner:
            problems.append(f"{path} owner {owner} (want {want_owner})")
        else:
            ok.append(f"{path.name} {owner} {mode:04o}")
    env_path = lib.host_path(f"{lib.APP_DIR}/.env")
    try:
        st = os.stat(env_path, follow_symlinks=False)
        mode = st.st_mode & 0o777
        if mode & 0o007:
            problems.append(f"{env_path} is world-accessible ({mode:04o}) — it holds the bot token")
        elif mode & 0o020:
            problems.append(f"{env_path} is group-writable ({mode:04o})")
        elif st.st_uid != 0 and not lib.SELFTEST:
            problems.append(f"{env_path} owner {_owner(st)} (want root)")
        else:
            ok.append(f".env {_owner(st)} {mode:04o}")
    except FileNotFoundError:
        problems.append(f"{env_path} is missing")
    if problems:
        items.add("red", "perms", "; ".join(problems))
    else:
        items.add("green", "perms", ", ".join(ok))


def check_disk(ctx: Any, items: Items) -> None:
    seen: set[int] = set()
    worst = "green"
    lines = []
    for raw in ("/", "/var", lib.APP_DIR):
        path = lib.host_path(raw)
        if not path.exists():
            continue
        st = os.stat(path)
        if st.st_dev in seen:
            continue
        seen.add(st.st_dev)
        usage = shutil.disk_usage(path)
        pct = 100.0 * usage.free / usage.total if usage.total else 0.0
        level = "red" if usage.free < DISK_RED_BYTES or pct < DISK_RED_PCT else "yellow" if pct < DISK_YELLOW_PCT else "green"
        worst = max(worst, level, key=("green", "yellow", "red").index)
        lines.append(f"{raw}: {usage.free / (1 << 30):.1f} GiB free ({pct:.0f}%)")
    items.add(worst, "disk", "; ".join(lines) or "no filesystem checked")


def check_reboot(ctx: Any, items: Items) -> None:
    flag = lib.host_path(REBOOT_FLAG)
    if not flag.exists():
        items.add("green", "reboot", "no reboot required")
        return
    try:
        pkgs = sorted(set(lib.host_path(REBOOT_PKGS).read_text(encoding="utf-8").split()))
    except OSError:
        pkgs = []
    items.add("yellow", "reboot", "a reboot is required" + (f" ({', '.join(pkgs[:8])})" if pkgs else ""))


CHECKS = (check_listeners, check_warp, check_failed_units, check_certs, check_helpers, check_perms, check_disk, check_reboot)


def step_plan(ctx: Any) -> int:
    ctx.event("plan", text="read-only: the self-check changes nothing on the host", read_only=True)
    print("read-only: nothing will change")
    return 0


def step_apply(ctx: Any) -> int:
    items = Items(ctx)
    for check in CHECKS:
        name = check.__name__.removeprefix("check_")
        ctx.say(f"checking {name}")
        try:
            check(ctx, items)
        except Exception as exc:  # one broken check must not hide the others
            items.add("yellow", name, f"the check itself failed: {type(exc).__name__}: {exc}")
    ctx.event("summary", **items.counts)
    lib.write_private(lib.artifact_path(ctx.run_id, "selfcheck.json"), json.dumps(items.counts).encode())
    print(f"green={items.counts['green']} yellow={items.counts['yellow']} red={items.counts['red']}")
    return 0


def step_verify(ctx: Any) -> int:
    summaries = [e for e in lib.read_events(ctx.run_id) if e.get("event") == "summary"]
    if not summaries:
        print("no summary line: the checks did not finish", file=sys.stderr)
        return 1
    return 0


def step_rollback(ctx: Any) -> int:
    print("read-only: nothing to roll back")
    return 0


if __name__ == "__main__":
    sys.exit(lib.contract_main(MODE, {"plan": step_plan, "apply": step_apply, "verify": step_verify, "rollback": step_rollback}, sys.argv[1:]))
