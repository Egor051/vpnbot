STATE_FILE = f"{STATE_DIR}/state.json"
LOCK_FILE = "/run/vpn-bot-cert.lock"
MARKER_DIR = "/etc/vpn-bot/uninstalled"
CRON_FILES = ("/var/spool/cron/crontabs/root", "/var/spool/cron/root")
CRON_DIR = "/etc/cron.d"
NGINX_CONF_DIRS = ("/etc/nginx/conf.d", "/etc/nginx/sites-enabled")
NGINX_CONF = "/etc/nginx/nginx.conf"
HYSTERIA_CONFIG = "/etc/hysteria/config.yaml"
NESTED_ENV = "VPN_BOT_CERT_NESTED"
