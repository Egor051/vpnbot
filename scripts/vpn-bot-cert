CA_SERVER = "letsencrypt"
NEW_KEYLENGTH = "ec-256"
COMMAND_TIMEOUT = 60
ACME_TIMEOUT = 900
LOCK_WAIT = 900
# acme.sh has no lock of its own, and its cron (`acme.sh --cron`, root's crontab) does not
# take ours: before issue / renew / adopt run acme.sh, another acme.sh process — a cron
# renewal — is waited for (then refused), so the two never change one domain together.
ACME_BUSY_WAIT = float(os.environ.get("VPN_BOT_CERT_SELFTEST_ACME_WAIT", "0")) if SELFTEST else 300.0
# … and a cron run that starts AFTER that wait must leave the domain alone: acme.sh --cron
# renews a domain only once its Le_NextRenewTime has passed, so the helper pushes it this
# far ahead while its own acme.sh works on the domain (cron_held_off).
CRON_HOLD_SECONDS = 3600
SETTLE_SECONDS = float(os.environ.get("VPN_BOT_CERT_SELFTEST_SETTLE", "0")) if SELFTEST else 2.0
MAX_PEM_BYTES = 1 << 20
MAX_NAMES = 10
RED_DAYS = 7
YELLOW_DAYS = 21
STAGE_SUFFIX = ".vpn-bot-cert-new"
OLD_SUFFIX = ".vpn-bot-cert-old"
EXIT_OK, EXIT_CONSUMER, EXIT_USAGE, EXIT_REFUSED, EXIT_CANNOT = 0, 1, 2, 3, 5

# acme.sh, installed when a host has none (`issue` only). A release pinned by its tag
# AND the sha256 of the two files it needs: the client and its Cloudflare DNS plugin.
ACME_VERSION = "3.1.1"
ACME_FILES: Mapping[str, tuple[str, str]] = {
    "acme.sh": (
        f"https://raw.githubusercontent.com/acmesh-official/acme.sh/{ACME_VERSION}/acme.sh",
