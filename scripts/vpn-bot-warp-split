#!/usr/bin/env bash
# vpn-bot-warp-split — selective WARP: listed prefixes via out-warp, rest direct via eth0.
# Runs AFTER vpn-bot-warp-routes (full-tunnel setup). Host stays direct — never touches main/SSH.
set -euo pipefail

IFACE="${WARP_IFACE:-out-warp}"
# WAN uplink: default to the interface of the main-table default route (portable to
# ens3/enp1s0/… names), not a hardcoded eth0. Still overridable via WAN_DEV.
WAN_DEV="${WAN_DEV:-$(ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}' || true)}"
WAN_DEV="${WAN_DEV:-eth0}"
PROXY_SRC="${WARP_PROXY_SRC:-172.16.0.2}"
CLIENT_NET="${WARP_CLIENT_NET:-10.0.0.0/24}"
# WARP endpoint: default to the live endpoint from `awg show` (never hardcoded) so a
# non-Cloudflare / self-hosted endpoint still gets the correct anti-loop /32 pin.
ENDPOINT_IP="${WARP_ENDPOINT_IP:-$(awg show "$IFACE" endpoints 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1 || true)}"
# Security: when invoked via sudo (SUDO_UID set by sudo, survives env_reset), ignore
# caller-supplied path overrides for the list and the intent marker and use the fixed
# defaults (defense-in-depth beyond sudoers env_reset). Non-sudo callers (the systemd
# unit, tests) may still override via env.
if [ -n "${SUDO_UID:-}" ]; then
    LIST="/etc/vpn-bot/warp-split.list"
    MARKER="/etc/vpn-bot/warp-split.disabled"
else
    LIST="${WARP_SPLIT_LIST:-/etc/vpn-bot/warp-split.list}"
    # Root-owned intent marker: when present the split routing is "off" — table T is
    # reconciled to EMPTY (all-direct) instead of to the list. Written/removed by the
    # vpn-bot-warp-split-state helper; honoured here so an "off" state survives reboot.
    MARKER="${WARP_SPLIT_DISABLED_MARKER:-/etc/vpn-bot/warp-split.disabled}"
fi
log(){ echo "[warp-split] $*"; }

fwmark="$(awg show "$IFACE" fwmark 2>/dev/null || true)"
[ -n "$fwmark" ] && [ "$fwmark" != off ] || { log "no fwmark for $IFACE (tunnel down?) — abort, routing left as-is"; exit 0; }
# Validate the hex shape before the arithmetic table conversion (parity with
# vpn-bot-warp-routes) so a malformed fwmark never reaches $(( )).
case "$fwmark" in
  0x[0-9a-fA-F]*) : ;;
  *) log "unexpected fwmark '$fwmark' for $IFACE — abort"; exit 0 ;;
esac
T=$(( fwmark ))
GW="$(ip route show default dev "$WAN_DEV" | awk '/default/{print $3; exit}')"
[ -n "$GW" ] || { log "no default gw on $WAN_DEV — abort"; exit 0; }
log "table T=$T iface=$IFACE wan=$WAN_DEV gw=$GW"

case "${1:-apply}" in
apply)
  # Boot/state honour: if the disabled marker is present, reconcile table T to
  # EMPTY (all-direct) instead of to the list.
  #
  # "Empty" has to include the table default, not just the per-prefix routes. On
  # the boot path this branch runs AFTER awg-quick (Table=auto installed
  # `default dev $IFACE` in table T) and AFTER vpn-bot-warp-routes (which did the
  # MASQUERADE swap: dropped `-s $CLIENT_NET -o $WAN_DEV -j MASQUERADE` and added
  # `-o $IFACE -j MASQUERADE`). Retracting only the per-prefix routes there leaves
  # that default in place — the "disabled" state would silently be a FULL tunnel,
  # the exact opposite of what the marker asks for and of what this branch logs.
  #
  # Dropping the default alone is not enough either: with an empty table T the
  # marked client/proxy traffic falls through to main and leaves via $WAN_DEV
  # un-masqueraded (warp-routes took that rule away), i.e. dead clients. So the
  # direct-WAN NAT and the awg0<->$WAN_DEV FORWARD accepts are restored here with
  # the same `-C … || -A/-I` idempotent pattern the enabled branch uses.
  #
  # Order is make-before-break: NAT/FORWARD are (re)installed BEFORE the tunnel
  # routes are torn down, so there is no window in which client packets egress via
  # $WAN_DEV without a matching MASQUERADE.
  #
  # The anti-loop endpoint route, the ip rules, the marker and the saved list file
  # are NOT touched — the list is re-applied verbatim on the next "on".
  if [ -e "$MARKER" ]; then
    for SRC in "$CLIENT_NET" "$PROXY_SRC"; do
      iptables -t nat -C POSTROUTING -s "$SRC" -o "$WAN_DEV" -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -s "$SRC" -o "$WAN_DEV" -j MASQUERADE
    done
    iptables -C FORWARD -i awg0 -o "$WAN_DEV" -j ACCEPT 2>/dev/null \
      || iptables -I FORWARD 1 -i awg0 -o "$WAN_DEV" -j ACCEPT
    iptables -C FORWARD -i "$WAN_DEV" -o awg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
      || iptables -I FORWARD 1 -i "$WAN_DEV" -o awg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
    ip route show table "$T" 2>/dev/null \
      | awk -v dev="$IFACE" '$1!="default" && $2=="dev" && $3==dev {print $1}' \
      | while read -r old; do
          ip route del "$old" dev "$IFACE" table "$T" 2>/dev/null || true
        done || true
    ip route del default dev "$IFACE" table "$T" 2>/dev/null || true
    log "split DISABLED by marker $MARKER — table $T flushed (per-prefix + default dev $IFACE), direct MASQUERADE on $WAN_DEV restored (all direct)"
    exit 0
  fi
  [ -s "$LIST" ] || { log "empty/missing $LIST — abort (refuse to blackhole)"; exit 0; }
  ip route del default dev "$IFACE" table "$T" 2>/dev/null || true
  if [ -n "$ENDPOINT_IP" ]; then
    ip route replace "$ENDPOINT_IP/32" via "$GW" dev "$WAN_DEV" table "$T"
  else
    log "WARNING: no WARP endpoint resolved — skipping anti-loop /32 pin"
  fi
  # Build the wanted prefix set from the list (comments/blanks/default-routes
  # dropped, deduplicated). awk rather than a bash read-loop: the loop's
  # membership test scanned one growing WANT string per line, which is O(n^2) and
  # the other half of the cost the batching below removes.
  want_list() {
    awk '{ sub(/#.*/, ""); gsub(/[[:space:]]/, "") }
         $0 != "" && $0 != "0.0.0.0/0" && $0 != "::/0" && !seen[$0]++ { print }' "$LIST"
  }
  n_want="$(want_list | wc -l | tr -d ' ')"

  # Both route phases go through `ip -force -batch -` / `ip -batch -` instead of
  # one `ip` process per prefix. Measured on this host: installing 1500 prefixes
  # takes 4.275s as separate processes and 0.096s as a batch (108 prefixes:
  # 0.284s -> 0.008s). At the WARP_SPLIT_MAX_PREFIXES ceiling the per-process form
  # spends longer forking than the whole apply is allowed to take.
  #
  # The two phases use different flags on purpose, preserving the exact semantics
  # they had as loops:
  #   * deletes were `|| true` per command (a route that raced away is not an
  #     error), so they keep `-force`, which continues past a failing line —
  #     the non-zero exit that -force still returns is swallowed, as before;
  #   * adds ran under `set -e`, aborting at the first failure with the earlier
  #     ones applied, which is exactly what plain `-batch` does.
  #
  # Reconcile: drop script-managed per-prefix routes (`<prefix> dev $IFACE`) in
  # table T that are no longer listed, so a removed prefix stops using WARP after
  # restart instead of lingering until reboot. Only `dev $IFACE` routes are touched
  # — the anti-loop (`$ENDPOINT_IP/32 via $GW dev $WAN_DEV`) is `dev $WAN_DEV`, never
  # matched; the table default was already removed above.
  #
  # Collected into a variable first rather than piped straight into `ip`: the
  # reading and the writing `ip` would otherwise be concurrent processes in one
  # pipeline, and — more usefully — a steady-state re-apply has nothing stale to
  # drop, so this skips the `ip` invocation entirely instead of handing it an
  # empty batch.
  stale="$(
    ip route show table "$T" 2>/dev/null \
      | awk -v dev="$IFACE" '$1!="default" && $2=="dev" && $3==dev {print $1}' \
      | awk -v dev="$IFACE" -v t="$T" '
          NR==FNR { want[$0]; next }
          !($0 in want) { print "route del " $0 " dev " dev " table " t }' <(want_list) -
  )" || true
  if [ -n "$stale" ]; then
    printf '%s\n' "$stale" | ip -force -batch - 2>/dev/null || true
  fi
  # Add/refresh the wanted prefixes (`replace` is idempotent — no dups on re-apply).
  want_list \
    | awk -v dev="$IFACE" -v t="$T" '{ print "route replace " $0 " dev " dev " table " t }' \
    | ip -batch -
  log "table T is now selective ($n_want prefixes)"
  for SRC in "$CLIENT_NET" "$PROXY_SRC"; do
    iptables -t nat -C POSTROUTING -s "$SRC" -o "$WAN_DEV" -j MASQUERADE 2>/dev/null \
      || iptables -t nat -A POSTROUTING -s "$SRC" -o "$WAN_DEV" -j MASQUERADE
  done
  iptables -C FORWARD -i awg0 -o "$WAN_DEV" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -i awg0 -o "$WAN_DEV" -j ACCEPT
  iptables -C FORWARD -i "$WAN_DEV" -o awg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -i "$WAN_DEV" -o awg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
  log "selective WARP applied"
  ;;
revert)
  ip route replace default dev "$IFACE" table "$T"
  iptables -t nat -D POSTROUTING -s "$CLIENT_NET" -o "$WAN_DEV" -j MASQUERADE 2>/dev/null || true
  iptables -t nat -D POSTROUTING -s "$PROXY_SRC"  -o "$WAN_DEV" -j MASQUERADE 2>/dev/null || true
  log "reverted to full-tunnel (default dev $IFACE restored in table $T)"
  ;;
*) echo "usage: $0 {apply|revert}" >&2; exit 2;;
esac
