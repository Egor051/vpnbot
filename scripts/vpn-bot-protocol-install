_DNS_NAME_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
_SHA_RE = re.compile(r"^[0-9a-f]{64}$")
_KEY_RE = re.compile(r"^[A-Za-z0-9_-]{43}$")
_ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$")
_ADDRESS_RE = re.compile(r"^[ \t]*Address[ \t]*=[ \t]*(.+?)[ \t]*$", re.IGNORECASE | re.MULTILINE)
# vpn-bot-wizard-lib's redaction (utils/redact.py): every line of the log goes through it.
_REDACT = (
    (re.compile(r"(?i)(secret=)[^&\s]+"), r"\1***"),
    (re.compile(r"\b(bot_token|token|password|passwd|secret|mtproto_secret|private_key|preshared_key|privatekey)\s*([:=])\s*[^,\s;]+", re.I), r"\1\2***"),
    (re.compile(r"\b(?:dd)?[0-9a-fA-F]{32,}\b"), "***"),
    (re.compile(r"\b\d{8,12}:[A-Za-z0-9_-]{35}\b"), "***"),
    (re.compile(r"(?i)\bBearer\s+[A-Za-z0-9_.~+/=-]{16,}\b"), "Bearer ***"),
    (re.compile(r"(?i)([a-z][a-z0-9+\-.]*://)([^:@/\s]+:[^@/\s]+@)"), r"\1***@"),
    (re.compile(r"\b[A-Za-z0-9+/]{43}={1,2}(?=[^A-Za-z0-9+/=]|$)"), "***"),
    (re.compile(r'("privateKey"\s*:\s*")[^"]*'), r"\1***"),
    (re.compile(r"(?i)\b(PrivateKey|Private key)\s*:\s*\S+"), r"\1: ***"),
)


def redact(text: str) -> str:
    for pattern, repl in _REDACT:
        text = pattern.sub(repl, text)
    return text


class Refused(Exception):
    """A finding that stops the run before anything changes (exit 3)."""


class Cannot(Exception):
    """A tool, a file or a download that is not there (exit 5)."""


class StepFailed(Exception):
    def __init__(self, step: str, message: str) -> None:
        super().__init__(message)
        self.step = step


# --------------------------------------------------------------------------- #
# The manifest. OWNED = what an uninstall removes (and nothing else); SHARED = what the
# protocol needs but does not own. tests/test_protocol_install_helper.py compares OWNED
# with `vpn-bot-protocol-uninstall manifest <proto>` and checks every SHARED path is on the
# uninstall's deny-list.
# --------------------------------------------------------------------------- #
@dataclass(frozen=True)
class Shared:
    what: str                      # the words the uninstall's skipped_shared uses for it
    why: str
    paths: tuple[str, ...] = ()
    packages: tuple[str, ...] = ()
    units: tuple[str, ...] = ()


@dataclass(frozen=True)
class Manifest:
    protocol: str
    units: tuple[str, ...]          # enabled and started
    templates: tuple[str, ...]      # template units: their files only
    unit_files: tuple[str, ...]
    paths: tuple[str, ...]
    packages: tuple[str, ...] = ()
    users: tuple[str, ...] = ()
    env_flag: str = ""              # <PROTO>_ENABLED=true here, =false by the uninstall
    env_settings: tuple[str, ...] = ()   # written here, inert after an uninstall (kept)
    shared: tuple[Shared, ...] = ()

    def as_json(self) -> dict[str, Any]:
        return {
            "protocol": self.protocol,
            "units": list(self.units) + list(self.templates),
            "templates": list(self.templates),
            "unit_files": list(self.unit_files),
            "paths": list(self.paths),
            "packages": list(self.packages),
            "users": list(self.users),
            "env_key": self.env_flag,
            "env_settings": list(self.env_settings),
            "marker": f"{MARKER_DIR}/{self.protocol}",
            "shared": [
                {"what": s.what, "why": s.why, "paths": list(s.paths), "packages": list(s.packages), "units": list(s.units)}
                for s in self.shared
            ],
        }


